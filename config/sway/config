# Read `man 5 sway` for a complete reference.
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term footclient
set $scripts ~/scripts

# Workspaces:
set $WS1  "1 "
set $WS2  "2 "
set $WS3  "3 "
set $WS4  "4 "
set $WS5  "5 "
set $WS6  "6 "
set $WS7  "7 "
set $WS8  "8 "
set $WS9  "9 "
set $WS10 "10 "

input type:keyboard {
    xkb_layout us,ara
    xkb_options grp:win_space_toggle,caps:escape,ctrl:swap_rwin_rctl
    xkb_numlock enabled
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
}

### Key bindings
bindsym $mod+Return exec $term
bindsym $mod+c kill
bindsym $mod+d exec fuzzel --placeholder "Application..."
floating_modifier $mod normal
bindsym $mod+Shift+r reload
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+i layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+t floating toggle
bindsym $mod+a focus parent
bindsym $mod+z focus child
bindgesture swipe:right workspace prev
bindgesture swipe:left workspace next
bindgesture swipe:down floating toggle
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

bindsym $mod+1 workspace $WS1
bindsym $mod+2 workspace $WS2
bindsym $mod+3 workspace $WS3
bindsym $mod+4 workspace $WS4
bindsym $mod+5 workspace $WS5
bindsym $mod+6 workspace $WS6
bindsym $mod+7 workspace $WS7
bindsym $mod+8 workspace $WS8
bindsym $mod+9 workspace $WS9
bindsym $mod+0 workspace $WS10

bindsym $mod+Shift+1 move container to workspace $WS1
bindsym $mod+Shift+2 move container to workspace $WS2
bindsym $mod+Shift+3 move container to workspace $WS3
bindsym $mod+Shift+4 move container to workspace $WS4
bindsym $mod+Shift+5 move container to workspace $WS5
bindsym $mod+Shift+6 move container to workspace $WS6
bindsym $mod+Shift+7 move container to workspace $WS7
bindsym $mod+Shift+8 move container to workspace $WS8
bindsym $mod+Shift+9 move container to workspace $WS9
bindsym $mod+Shift+0 move container to workspace $WS10

workspace_auto_back_and_forth yes
bindsym Mod1+Tab workspace back_and_forth

bindsym $mod+s mode "resize"
mode "resize" {
        bindsym $left  resize shrink width 2 px or 2 ppt
        bindsym $down  resize shrink height 2 px or 2 ppt
        bindsym $up    resize grow height 2 px or 2 ppt
        bindsym $right resize grow width 2 px or 2 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
}

bindsym $mod+Shift+s exec sh -c 'geometry=$(slurp) && [ -n "$geometry" ] && grim -g "$geometry" - | wl-copy && notify-send -t 1000 "Screenshot" "Area copied to clipboard"'
bindsym $mod+b                exec waterfox 
bindsym $mod+Shift+Return     exec thunar
bindsym $mod+BackSpace                exec pkill -SIGUSR1 waybar
bindsym $mod+Escape           exec $scripts/power.sh
bindsym $mod+Shift+b          exec $scripts/browser.sh
bindsym --locked $mod+Right   exec $scripts/volume.sh up
bindsym --locked XF86AudioRaiseVolume exec $scripts/volume.sh up
bindsym --locked $mod+Left    exec $scripts/volume.sh down
bindsym --locked XF86AudioLowerVolume exec $scripts/volume.sh down
bindsym --locked XF86AudioMute exec $scripts/volume.sh mute
bindsym --locked XF86AudioMicMute exec $scripts/mic.sh toggle
bindsym --locked $mod+Up exec $scripts/mic.sh up
bindsym --locked $mod+Down exec $scripts/mic.sh down
bindsym Print                 exec $scripts/screenshot.sh
bindsym $mod+m                exec thunderbird
bindsym $mod+y                exec $scripts/ytdmenu.sh
bindsym $mod+n                exec $term sh -c 'sleep 0.1; exec nvim'
bindsym Shift+Return          exec $term yazi
bindsym ctrl+space            exec mpc toggle 
bindsym ctrl+XF86AudioPrev    exec mpc prev
bindsym ctrl+XF86AudioNext    exec mpc next
bindsym ctrl+BackSpace        exec mpc stop
bindsym $mod+o                exec $scripts/hub-scripts.sh
bindsym $mod+e                exec $scripts/ocr_us.sh
bindsym $mod+period           exec rofimoji 2> /dev/null
bindsym $mod+v                exec $scripts/clip.sh 
bindsym $mod+w                exec $scripts/websearch.sh
bindsym $mod+grave            exec $scripts/dropterm.sh
bindsym --locked XF86MonBrightnessUp   exec $scripts/brightness.sh up
bindsym --locked XF86MonBrightnessDown exec $scripts/brightness.sh down
bindsym $mod+Ctrl+h move left
bindsym $mod+Ctrl+l move right
bindsym $mod+Ctrl+j move down
bindsym $mod+Ctrl+k move up

# Autostart
exec_always dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway XDG_SESSION_TYPE=wayland
exec $scripts/sway-systemd.sh
exec autotiling
exec --no-startup-id wl-paste --type text --watch cliphist store
exec --no-startup-id wl-paste --type image --watch cliphist store
exec swaync
bindsym $mod+Shift+n exec swaync-client -t -sw
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec swaybg -i ~/.cache/wallpaper.jpg -m fill
exec --no-startup-id dropbox-cli start -i
exec /usr/lib/mate-polkit/polkit-mate-authentication-agent-1

# Idle timeouts (seconds)
set $lock_timeout   300
set $screen_timeout 30
set $total_timeout  600

exec swayidle -w \
    timeout $lock_timeout 'swaylock -f' \
    timeout $total_timeout 'swaymsg "output * power off"' \
              resume 'swaymsg "output * power on"' \
    timeout $screen_timeout 'pgrep -xu "$USER" swaylock >/dev/null && swaymsg "output * power off"' \
         resume 'pgrep -xu "$USER" swaylock >/dev/null && swaymsg "output * power on"' \
    before-sleep 'swaylock -f' \
    lock 'swaylock -f' \
    unlock 'pkill -xu "$USER" -SIGUSR1 swaylock'

# Don't let swayidle lock/sleep while audio is actively playing
exec sway-audio-idle-inhibit

# Theme colors (switch with ~/scripts/theme.sh)
set $bg         #272e33
set $bg_soft    #2e383c
set $bg_alt     #374145
set $fg         #d3c6aa
set $fg_dim     #859289
set $red        #e67e80
set $green      #a7c080
set $yellow     #dbbc7f
set $blue       #7fbbb3
set $purple     #d699b6
set $aqua       #83c092

# border style
gaps inner 3
gaps outer 3
default_border pixel 1
default_floating_border normal
smart_borders on
focus_on_window_activation smart
default_orientation horizontal

bar {
    swaybar_command waybar
}

client.focused          $blue   $bg_soft $fg     $yellow $blue
client.unfocused        $bg_alt $bg      $fg_dim $bg_alt $bg_alt
client.focused_inactive $bg_alt $bg      $fg_dim $bg_alt $bg_alt
client.urgent           $red    $red     $fg     $red $red
client.background       $bg


# Rules
