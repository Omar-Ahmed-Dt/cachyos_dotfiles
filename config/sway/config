for_window [title="Picture-in-Picture"] floating enable, sticky enable
for_window [title=".* is sharing your screen."] floating enable, sticky enable
for_window [app_id="floating_shell_portrait"] floating enable, sticky enable
for_window [app_id="floating_shell"] floating enable, sticky enable

# Float known tools
for_window [class="Lxappearance"] floating enable
# for_window [class="Thunar" title="File Operation Progress"] floating enable
for_window [app_id="virt-manager"] floating enable
for_window [class="vlc"] floating enable
# for_window [app_id="thunar"] floating enable
for_window [app_id="thunderbird" title=".*Reminder"] floating enable
for_window [instance="around"] floating enable, sticky enable
for_window [app_id="xsensors"] floating enable
for_window [app_id="waydroid.*"] floating enable
for_window [app_id="spotify-launcher"] floating enable
for_window [class="Deluge"] floating enable
for_window [class="Engrampa"] floating enable
for_window [app_id="blueman-manager"] floating enable
for_window [app_id="pavucontrol"] floating enable
