/* ── Everforest Dark — floating pill bar ─────────────────────────────────── */

@define-color bg0 #2d353b;
@define-color bg1 #343f44;
@define-color bg2 #3d484d;
@define-color bg3 #475258;
@define-color bg4 #4f585e;

@define-color fg #d3c6aa;
@define-color red #e67e80;
@define-color orange #e69875;
@define-color yellow #dbbc7f;
@define-color yellow_bright #e6c88c;
@define-color green #a7c080;
@define-color aqua #83c092;
@define-color blue #7fbbb3;
@define-color purple #d699b6;
@define-color grey0 #7a8478;
@define-color grey1 #859289;
@define-color grey2 #9da9a0;

@define-color module_text #000000;

* {
  font-family: "JetBrainsMono Nerd Font", "Symbols Nerd Font", monospace;
  font-size: 10px;
  font-weight: 600;
  min-height: 0;
}

window#waybar {
  background: @bg0;
  border-radius: 12px;
  margin: 4px 8px 0 8px;
  border: 1px solid @grey1;
}

/* ── Workspaces ───────────────────────────────────────────────────────────── */

#workspaces {
  background: transparent;
  margin: 0 2px;
}

#workspaces button {
  padding: 0 5px;
  border-radius: 6px;
  margin: 2px 1px;
  color: white;
  background: transparent;
}

#workspaces button.focused {
  background: @green;
  color: @bg0;
  font-weight: 700;
}

#workspaces button.urgent {
  background: @red;
  color: white;
}

/* ── Shared module base ───────────────────────────────────────────────────── */

#custom-cpu,
#custom-pacman,
#custom-mpd,
#clock,
#pulseaudio,
#backlight,
#battery,
#cpu,
#memory,
#disk,
#temperature,
#custom-weather,
#custom-uptime,
#custom-nettraf,
#tray,
#mode,
#idle_inhibitor,
#mpd,
#language,
#scratchpad,
#power-profiles-daemon {
  padding: 1px 7px;
  border-radius: 6px;
  margin: 2px 1px;
}

/* ── LEFT SIDE — spectrum: mpd · power · idle · language ─────────────────── */

#custom-mpd {
  background: @red;
  color: @module_text;
}

#power-profiles-daemon,
#power-profiles-daemon.performance,
#power-profiles-daemon.balanced,
#power-profiles-daemon.power-saver {
  background: @orange;
  color: @module_text;
}

#idle_inhibitor {
  background: @yellow;
  color: @module_text;
}

#idle_inhibitor.activated {
  background: @yellow_bright;
  color: @module_text;
}

#language {
  background: @green;
  color: @module_text;
}

#scratchpad {
  background: @bg2;
  color: @module_text;
}

#scratchpad.empty {
  background: transparent;
}

/* ── CENTER — clock ───────────────────────────────────────────────────────── */

#clock {
  background: @bg4;
  color: white;
  font-weight: 700;
  border-radius: 6px;
  padding: 1px 10px;
}

/* ── RIGHT SIDE — spectrum: weather · pacman · uptime · nettraf · battery
                             · cpu · memory · backlight · pulseaudio · tray ─ */

#custom-weather {
  background: @orange;
  color: @module_text;
}

#custom-pacman {
  background: @yellow;
  color: @module_text;
}

/* #custom-uptime { */
/*   background: @yellow; */
/*   color: @module_text; */
/* } */

#custom-nettraf {
  background: @green;
  color: @module_text;
}

#battery {
  background: @aqua;
  color: @module_text;
}

#battery.charging,
#battery.plugged {
  background: @green;
  color: @module_text;
}

#battery.critical {
  background: @red;
  color: @module_text;
}

#battery.warning {
  background: @yellow;
  color: @module_text;
}

#custom-cpu {
  background: @blue;
  color: @module_text;
}

#memory {
  background: @purple;
  color: @module_text;
}

#backlight {
  background: @orange;
  color: @module_text;
}

#pulseaudio {
  background: @yellow;
  color: @module_text;
}

#pulseaudio.muted {
  background: @bg2;
  color: @module_text;
}

#tray {
  background: @bg1;
  border-radius: 8px;
}

/* ── Misc ─────────────────────────────────────────────────────────────────── */

#network {
  background: @blue;
  color: @module_text;
}

#network.disconnected {
  background: @red;
  color: @module_text;
}

#temperature {
  background: @orange;
  color: @module_text;
}

#temperature.critical {
  background: @red;
  color: @module_text;
}

#cpu {
  background: @blue;
  color: @module_text;
}

#mpd {
  background: @aqua;
  color: @module_text;
}

#mpd.paused {
  background: @bg3;
  color: @module_text;
}

#mpd.stopped {
  background: @bg2;
  color: @module_text;
}

#mode {
  background: @yellow;
  color: @module_text;
  font-weight: 700;
}
