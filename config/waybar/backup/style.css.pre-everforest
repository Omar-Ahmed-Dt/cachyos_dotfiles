/* ── dwm default bar — colors from dwm's config.def.h ────────────────────── */

@define-color gray1 #32302f; /* bar background (gruvbox dark soft) */
@define-color gray2 #3c3836; /* unfocused border */
@define-color gray3 #ebdbb2; /* normal text (dwm default: #bbbbbb) */
@define-color gray4 #ebdbb2; /* selected text (dwm default: #eeeeee) */
@define-color cyan  #458588; /* selected background (gruvbox blue) */
@define-color red   #cc241d; /* urgent background (gruvbox red) */

* {
  font-family: "JetBrainsMono Nerd Font", "Symbols Nerd Font", monospace;
  font-size: 9.5px;
  font-weight: bold;
  color: #ebdbb2;
  min-height: 0;
  border: none;
  border-radius: 0;
  box-shadow: none;
}

/* Flat, full-width bar like dwm — no rounding, no float margins */
window#waybar {
  background: alpha(@gray1, 0.9);
  color: @gray3;
}

/* ── Tags (workspaces) ────────────────────────────────────────────────────── */

#workspaces button {
  padding: 0 6px;
  margin: 0;
  color: @gray3;
  background: transparent;
}

/* GTK themes add hover styling to buttons; dwm has none */
#workspaces button:hover {
  background: transparent;
  color: @gray3;
}

#workspaces button.focused {
  background: @cyan;
  color: @gray4;
}

#workspaces button.urgent {
  background: @red;
  color: @gray3;
}

/* Layout symbol slot, e.g. sway's resize mode */
#mode {
  padding: 0 6px;
  color: @gray3;
}

/* ── Status text ──────────────────────────────────────────────────────────── */

#custom-cpu,
#custom-mpd,
#clock,
#pulseaudio,
#backlight,
#battery,
#cpu,
#memory,
#disk,
#temperature,
#custom-weather,
#custom-uptime,
#custom-nettraf,
#tray,
#idle_inhibitor,
#mpd,
#language,
#scratchpad,
#power-profiles-daemon {
  padding: 0 4px;
  margin: 0;
  color: @gray3;
  background: transparent;
}

#custom-sep {
  padding: 0 2px;
  color: @gray3;
}

/* ── Tooltips (e.g. clock's date/calendar popup) ─────────────────────────── */

tooltip {
  background: @gray1;
  border: 1px solid @gray2;
}

tooltip label {
  color: @gray3;
  padding: 10px 14px;
}

calendar {
  background: @gray1;
  color: @gray3;
  padding: 6px;
}

/* GTK3 marks "today" via :indeterminate (not a .today class) and the
   actively selected day via :selected — waybar's clock defaults the
   selection to today, so style both the same. */
calendar:selected,
calendar:indeterminate {
  background: @cyan;
  color: @gray4;
}

calendar.header,
calendar.highlight {
  color: @gray4;
}

/* ── Tray — tint icons with the text color ────────────────────────────────── */
/* Only icons with a -symbolic variant in the icon theme can be recolored;
   apps that ship their own pixmaps keep their original colors. */

#tray {
  -gtk-icon-style: symbolic;
}

#tray > * {
  color: @gray3;
  -gtk-icon-style: symbolic;
}

#tray > .needs-attention {
  color: @gray4;
}
