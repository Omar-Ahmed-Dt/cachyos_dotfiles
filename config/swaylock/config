# Use the current screen's screenshot as background
screenshots

# Apply effects
effect-blur=7x5
effect-vignette=0.5:0.5

# Clock and indicator settings
clock
indicator
timestr="%H:%M"
datestr="%a, %d %b"
indicator-radius=100
indicator-thickness=8
ignore-empty-password
show-failed-attempts

# Everforest Dark Theme (medium)
# Colors reference:
#   bg0      #2d353b    fg       #d3c6aa
#   red      #e67e80    green    #a7c080
#   yellow   #dbbc7f    blue     #7fbbb3
#   orange   #e69875    aqua     #83c092
#   bg1      #343f44    bg3      #4f585e

# Background (dark everforest bg0)
color=2d353bff

# Ring: idle / cleared / verifying / wrong / caps-lock
ring-color=4f585eff
ring-clear-color=83c092ff
ring-ver-color=7fbbb3ff
ring-wrong-color=e67e80ff
ring-caps-lock-color=dbbc7fff

# Inside of the ring
inside-color=232a2eff
inside-clear-color=2d353bff
inside-ver-color=2d353bff
inside-wrong-color=2d353bff
inside-caps-lock-color=2d353bff

# Line between ring and inside
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
line-caps-lock-color=00000000

# Key highlight when typing
key-hl-color=a7c080ff
bs-hl-color=e67e80ff
caps-lock-key-hl-color=dbbc7fff
caps-lock-bs-hl-color=e69875ff

# Text on the indicator
text-color=d3c6aaff
text-clear-color=83c092ff
text-ver-color=7fbbb3ff
text-wrong-color=e67e80ff
text-caps-lock-color=dbbc7fff

# Separator
separator-color=00000000

# Layout / keyboard indicator
layout-bg-color=2d353bcc
layout-border-color=4f585eff
layout-text-color=d3c6aaff

# Font
font=monospace
font-size=20
