#my config

# set sandbox none
set statusbar-h-padding 0
set statusbar-v-padding 0
# set page-padding 1
# set selection-clipboard clipboard
map ^u scroll half-up
map ^d scroll half-down
map d toggle_page_mode
map r reload
map R rotate
map <C-j> scroll full-down
map <C-k> scroll full-up
# map K zoom in 
map _ zoom out
map i recolor
map p print
map gg goto top

# colors: everforest dark
set default-bg                  "#2D353B"
set default-fg                  "#343F44"

set statusbar-fg                "#D3C6AA"
set statusbar-bg                "#3D484D"

set inputbar-bg                 "#2D353B"
set inputbar-fg                 "#A7C080"

set notification-bg             "#2D353B"
set notification-fg             "#A7C080"

set notification-error-bg       "#2D353B"
set notification-error-fg       "#E67E80"

set notification-warning-bg     "#2D353B"
set notification-warning-fg     "#DBBC7F"

set highlight-color              "#DBBC7F"
set highlight-active-color      "#7FBBB3"

set completion-bg               "#343F44"
set completion-fg               "#7FBBB3"

set completion-highlight-fg     "#D3C6AA"
set completion-highlight-bg     "#7FBBB3"

set recolor-lightcolor          "#2D353B"
set recolor-darkcolor           "#D3C6AA"

# set recolor                     "true"
set recolor-keephue             "true"
